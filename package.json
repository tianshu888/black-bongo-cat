{
  "name": "black-bongo-cat",
  "version": "2.4.1",
  "author": "BongoCat3D",
  "description": "Adorable Black Bongo Cat desktop pet with squishy face physics, global key/mouse sync, and popping keycaps",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.bongocat.desktop3d",
    "productName": "小黑猫桌宠",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/afterPack.cjs",
    "files": [
      "electron/**/*",
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/three/examples/**/*",
      "!node_modules/three/src/**/*",
      "!node_modules/three/build/three.tsl.js",
      "!node_modules/three/build/three.webgpu.js",
      "!node_modules/three/build/three.webgpu.nodes.js",
      "!node_modules/three/build/three.cjs",
      "!node_modules/uiohook-napi/prebuilds/darwin-*/**/*",
      "!node_modules/uiohook-napi/prebuilds/linux-*/**/*",
      "!node_modules/uiohook-napi/prebuilds/win32-arm64/**/*",
      "!node_modules/koffi/doc/**/*",
      "!node_modules/koffi/lib/**/*",
      "!node_modules/koffi/vendor/**/*",
      "!debug_capture.png",
      "!启动小黑猫.bat"
    ],
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**",
      "**/node_modules/koffi/**",
      "**/node_modules/@koromix/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "小黑猫桌宠-极速安装版.exe"
    },
    "portable": {
      "artifactName": "小黑猫桌宠.exe"
    }
  },
  "dependencies": {
    "koffi": "^3.3.8",
    "three": "^0.187.0",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0"
  }
}
